# Convex deployment URLs
# Local dev example:
# VITE_CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_SITE_URL=https://<your-deployment>.convex.site

VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_ALLOWED_HOSTS=
VITE_ENABLE_DEBUG_AUTH=false
VITE_VAPID_PUBLIC_KEY=
# Optional fallback for server-side conversion when VAPID_PRIVATE_KEY is a raw 32-byte key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

TAILWATCH_VOLUME_KEY=
